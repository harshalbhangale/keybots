# Copy to server/.env and fill in. Names only here; never commit values.

# KLIPY app key for the keyboard's GIFs (the server calls KLIPY; the phone never sees it). KLIPY_API_KEY works too.
KLIPY_APP_KEY=
# Serper key for the AI's web search (Google results), used when no Brave key is set.
SERPER_API_KEY=
