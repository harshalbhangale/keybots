	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>tech.airkey.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>keybots</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Keybots uses Face ID before you approve a payment or change your limits.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Keybots talks to your Keybots server on this network to run your agents.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchInk</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
